# Default: Auto-detect text files and normalize to LF
* text=auto eol=lf

# Shell scripts must use LF
*.sh text eol=lf
*.bash text eol=lf

# Python files use LF
*.py text eol=lf

# Windows scripts use CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Configuration files
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf

# Binary files (prevent corruption)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.db binary
*.lmdb binary
*.pyc binary
*.so binary
*.dll binary
