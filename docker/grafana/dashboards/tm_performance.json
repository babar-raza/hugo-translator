        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 7,
      "options": {
        "showHeader": true,
        "sortBy": []
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "sum by (worker_id) (tm_lookups_total)",
          "refId": "A",
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (worker_id) (tm_hits_l1)",
          "refId": "B",
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (worker_id) (tm_hits_l2)",
          "refId": "C",
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (worker_id) (tm_hits_l3)",
          "refId": "D",
          "legendFormat": "",
          "format": "table",
          "instant": true
        },
        {
          "expr": "sum by (worker_id) (tm_misses)",
          "refId": "E",
          "legendFormat": "",
          "format": "table",
          "instant": true
        }
      ],
      "title": "TM Statistics by Worker",
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": {
            "byField": "worker_id"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "worker_id": "Worker",
              "Value #A": "Total Lookups",
              "Value #B": "L1 Hits",
              "Value #C": "L2 Hits",
              "Value #D": "L3 Hits",
              "Value #E": "Misses"
            }
          }
        },
        {
          "id": "calculateField",
          "options": {
            "mode": "binary",
            "reduce": {
              "reducer": "sum"
            },
            "replaceFields": false,
            "binary": {
              "left": "L1 Hits",
              "operator": "+",
              "right": "L2 Hits"
            },
            "alias": "Total Hits"
          }
        }
      ],
      "type": "table"
    }
