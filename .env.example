# Example Environment Configuration
# Copy this file to .env.production and customize for your environment

# System Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG
FLOW_ARTIFACT_DETAIL=summary

# Paths (customize for your setup)
CONFIG_PATH=./config
CONTENT_ROOT=./content

# Content repository roots (used by site profiles for content_roots resolution)
# Set these to the absolute path of your cloned content repositories
ASPOSE_NET_CONTENT=/path/to/aspose.net/content
ASPOSE_ORG_CONTENT=/path/to/aspose.org/content
OUTPUT_DIR=./output
TM_DATA_PATH=./data/tm
MODEL_CACHE_PATH=./data/models
ARTIFACTS_PATH=./data/artifacts
LOGS_PATH=./data/logs
BACKUP_PATH=./backups

# Translation Memory Configuration
TM_L1_CACHE_SIZE=10000
TM_L2_MAX_SIZE_MB=1024
TM_L3_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
TM_SEMANTIC_THRESHOLD=0.80
TM_USE_SEMANTIC=true

# Model Runtime Configuration
# Available models: m2m100_418m, m2m100_1.2b, nllb_200_600m, small100
DEFAULT_MODEL=m2m100_418m
DEVICE=auto  # Options: auto, cpu, cuda, mps
MODEL_BATCH_SIZE=32
MAX_CACHED_MODELS=2

# Orchestrator Configuration
ORCHESTRATOR_MODE=manual  # Options: auto, manual
MAX_WORKERS=4
SWEEP_INTERVAL_HOURS=24
FILE_WATCHER_ENABLED=false
FILE_WATCHER_DEBOUNCE_SECONDS=2.0

# Performance Settings
PARALLEL_TRANSLATION=true
MAX_PARALLEL_FILES=4

# Observability Configuration
METRICS_ENABLED=true
METRICS_PORT=9090
PROMETHEUS_PUSHGATEWAY=

# Telemetry Configuration (HTTP API + Local Buffer)
# The telemetry client POSTs metrics to the telemetry API service
# and maintains a local buffer for guaranteed write delivery

# Telemetry API endpoint (default: http://localhost:8765)
# NOTE: local-telemetry uses METRICS_API_URL (not TELEMETRY_API_URL)
METRICS_API_URL=http://localhost:8765

# Local buffer directory for guaranteed writes when API is unavailable
# Events are buffered as .jsonl files and synced when API comes online
TELEMETRY_BUFFER_DIR=C:/telemetry/hugo-translator/buffer

# Optional: Disable telemetry entirely
# HUGO_TRANSLATOR_TELEMETRY_ENABLED=false

# Telemetry Module Path (TEL-04)
# Path to local-telemetry source directory (optional)
# Override this if the telemetry module is installed in a non-standard location
# Default: C:\Users\prora\OneDrive\Documents\GitHub\local-telemetry\src
#
# When to use:
#   - Development: Point to local checkout of local-telemetry for debugging
#   - Production: Set if telemetry is installed in custom location
#   - Docker: Set to match container volume mount paths
#
# Path format:
#   Windows: Use raw strings (single backslashes) or double backslashes
#   Linux/Mac: Use forward slashes
#
# Example values:
#   Windows: TELEMETRY_SRC_PATH=C:\custom\path\to\local-telemetry\src
#   Linux:   TELEMETRY_SRC_PATH=/opt/local-telemetry/src
#   Docker:  TELEMETRY_SRC_PATH=/app/telemetry/src
#
# TELEMETRY_SRC_PATH=C:\Users\prora\OneDrive\Documents\GitHub\local-telemetry\src

# MCP Worker Configuration
WORKER_ID=worker-dev-1
WORKER_DEVICE=auto

# Validation Settings
VALIDATION_ENABLED=true
VALIDATION_STRICT_MODE=false

# Security Settings
MAX_FILE_SIZE_MB=10
ENABLE_INPUT_VALIDATION=true
SANITIZE_OUTPUT=true

# Feature Flags
ENABLE_PARALLEL_PROCESSING=true
ENABLE_SEMANTIC_TM=true
ENABLE_MODEL_BENCHMARKING=false
ENABLE_AUTO_MODEL_SELECTION=true

# Database (if using Redis for job queue)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# HuggingFace Token (optional, for private models or avoiding rate limits)
# HF_TOKEN=your_huggingface_token_here

# Grafana (Docker deployment)
GRAFANA_ADMIN_PASSWORD=changeme

# API Keys and Secrets
# Add any additional API keys or secrets here
# Never commit this file with real credentials!
