{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Target Languages Schema",
  "description": "Validation schema for target_languages.yaml",
  "type": "object",
  "required": ["version", "languages"],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "last_updated": {
      "type": "string",
      "format": "date"
    },
    "languages": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "iso_code",
          "name",
          "native_name",
          "aspose_locale",
          "direction",
          "script",
          "family"
        ],
        "properties": {
          "iso_code": {
            "type": "string",
            "pattern": "^[a-z]{2}$",
            "description": "ISO 639-1 two-letter language code"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "description": "English name of the language"
          },
          "native_name": {
            "type": "string",
            "minLength": 1,
            "description": "Native name in the language's script"
          },
          "aspose_locale": {
            "type": "string",
            "pattern": "^[a-z]{2}-[a-z]{2}$",
            "description": "Aspose locale code (e.g., en-us, fr-fr)"
          },
          "direction": {
            "type": "string",
            "enum": ["ltr", "rtl"],
            "description": "Text direction: left-to-right or right-to-left"
          },
          "script": {
            "type": "string",
            "minLength": 4,
            "maxLength": 4,
            "description": "ISO 15924 script code (e.g., Latn, Cyrl, Arab)"
          },
          "family": {
            "type": "string",
            "description": "Language family classification"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
